{
  "name": "barepane",
  "version": "0.9.0-beta.1",
  "private": true,
  "description": "Desktop workstation for your Linux VPS: files, editor, and a real terminal over plain SSH. Nothing to install on the server.",
  "license": "MIT",
  "author": {
    "name": "Usman Bhatti",
    "email": "usmanbhatti.dev@gmail.com",
    "url": "https://barepane.com"
  },
  "homepage": "https://barepane.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usmanbhatti-dev/barepane.git"
  },
  "bugs": {
    "url": "https://github.com/usmanbhatti-dev/barepane/issues"
  },
  "keywords": [
    "ssh",
    "sftp",
    "vps",
    "linux",
    "terminal",
    "electron",
    "devops",
    "sysadmin"
  ],
  "type": "module",
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/prepare-dev-electron.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node --experimental-strip-types --test shared/*.test.ts",
    "build": "vite build",
    "pack": "npm run pack:mac && npm run pack:win && npm run pack:linux",
    "pack:mac": "vite build && electron-builder --mac --publish never -c.mac.identity=null",
    "pack:win": "vite build && electron-builder --win --publish never",
    "pack:linux": "vite build && electron-builder --linux --x64 --publish never",
    "icons": "electron scripts/build-icons.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "pack:linux:arm64": "vite build && electron-builder --linux --arm64 --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.1"
  },
  "build": {
    "appId": "com.barepane.desktop",
    "productName": "Barepane",
    "copyright": "Copyright © 2026 Usman Bhatti and Barepane contributors",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/ssh2/**",
      "node_modules/cpu-features/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "gatekeeperAssess": false,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "build/icons",
      "category": "Network",
      "maintainer": "Usman Bhatti <usmanbhatti.dev@gmail.com>",
      "synopsis": "Desktop workstation for your Linux VPS over SSH",
      "target": "AppImage"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "usmanbhatti-dev",
        "repo": "barepane"
      }
    ]
  }
}
